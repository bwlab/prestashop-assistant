#!/usr/bin/env bash
# Merchant Assistant - client locale (macOS bash 3.2, Linux, Git Bash su Windows).
# Tutta la logica sul DB gira sul server tramite remote/ma.php inviato via stdin.
set -u

MA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REMOTE_PHP="$MA_ROOT/remote/ma.php"
STATE="${MA_HOME:-$HOME/.merchant-assistant}"
CONF="$STATE/attivazione.conf"
KEY="$STATE/id_ed25519"
KNOWN="$STATE/known_hosts"
CHG="$STATE/changes"
TOKEN_TTL=1800   # token prod valido 30 minuti
PREVIEW_TTL=3600 # anteprima valida 1 ora

die() { echo "ERRORE: $*" >&2; exit 3; }
need_conf() { [ -f "$CONF" ] || die "configurazione assente: esegui prima 'ma setup import <file-attivazione>'"; }
cfg() { grep -E "^$1=" "${2:-$CONF}" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '\r'; }
workdir() {
  local w; w="$(cat "$STATE/workdir" 2>/dev/null)"
  [ -n "$w" ] && [ -d "$w" ] || die "cartella di lavoro non impostata: 'ma setup workdir <cartella>'"
  echo "$w"
}
check_env() { case "${1:-}" in stage|prod) ;; *) die "ambiente obbligatorio: stage oppure prod";; esac; }
sha() { if command -v sha1sum >/dev/null 2>&1; then sha1sum; else shasum; fi | cut -c1-12; }
now() { date +%s; }
json_str() {
  local s="$1"
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

# remote <env> <comando> <json-extra>   -> esegue remote/ma.php sul server dell'ambiente
remote() {
  local env="$1" cmd="$2" extra="${3:-}" payload php
  need_conf
  payload="{\"docroot\":$(json_str "$(cfg "$env.docroot")")${extra:+,$extra}}"
  payload="$(printf '%s' "$payload" | base64 | tr -d '\n')"
  php="$(cfg "$env.php")"; php="${php:-php}"
  if [ -n "${MA_TRANSPORT:-}" ]; then # solo per test: es. "docker exec -i <container>"
    $MA_TRANSPORT "$php" -- "$cmd" "$payload" < "$REMOTE_PHP"
    return
  fi
  [ -f "$KEY" ] || die "chiave SSH assente: 'ma setup keygen'"
  ssh -i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15 \
      -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$KNOWN" \
      -p "$(cfg "$env.port")" "$(cfg "$env.user")@$(cfg "$env.host")" \
      "$php" -- "$cmd" "$payload" < "$REMOTE_PHP"
}

log_entry() { # log_entry <env> <azione> <id> <corpo>
  local w f; w="$(workdir)"; mkdir -p "$w/log"; f="$w/log/$(date +%F).md"
  [ -f "$f" ] || printf '# Registro attività %s\n\n' "$(date +%F)" > "$f"
  printf '## %s · %s · %s%s\n%s\n\n' "$(date +%H:%M)" "$(echo "$1" | tr a-z A-Z)" "$2" "${3:+ · $3}" "$4" >> "$f"
  echo "log: $f"
}

cmd_setup() {
  local sub="${1:-status}"; shift || true
  mkdir -p "$STATE" "$CHG"; chmod 700 "$STATE" 2>/dev/null
  case "$sub" in
    import)
      local f="${1:-}" e k missing=""
      [ -f "$f" ] || die "file di attivazione non trovato: $f"
      for e in stage prod; do for k in host port user docroot hostkey; do
        [ -n "$(cfg "$e.$k" "$f")" ] || missing="$missing $e.$k"
      done; done
      [ -z "$missing" ] || die "file di attivazione incompleto, mancano:$missing"
      tr -d '\r' < "$f" > "$CONF"
      : > "$KNOWN"
      for e in stage prod; do
        local h p; h="$(cfg "$e.host")"; p="$(cfg "$e.port")"
        [ "$p" = "22" ] || h="[$h]:$p"
        echo "$h $(cfg "$e.hostkey")" >> "$KNOWN"
      done
      echo "attivazione importata per: $(cfg cliente)"
      echo "stage: $(cfg stage.user)@$(cfg stage.host) $(cfg stage.docroot)"
      echo "prod:  $(cfg prod.user)@$(cfg prod.host) $(cfg prod.docroot)" ;;
    keygen)
      if [ ! -f "$KEY" ]; then
        ssh-keygen -q -t ed25519 -N "" -C "merchant-assistant $(cfg cliente 2>/dev/null)" -f "$KEY" || die "ssh-keygen fallito"
        chmod 600 "$KEY"
        echo "chiave creata."
      else
        echo "chiave già presente (non la ricreo)."
      fi
      echo "CHIAVE PUBBLICA da inviare a bwlab (la privata non va mai inviata):"
      cat "$KEY.pub" ;;
    workdir)
      local w="${1:-}"
      [ -n "$w" ] || die "indica la cartella di lavoro"
      mkdir -p "$w/report" "$w/export" "$w/modifiche" "$w/rollback" "$w/log" || die "non riesco a creare $w"
      (cd "$w" && pwd) > "$STATE/workdir"
      echo "cartella di lavoro: $(cat "$STATE/workdir")" ;;
    status)
      echo "attivazione: $([ -f "$CONF" ] && cfg cliente || echo 'NO')"
      echo "chiave:      $([ -f "$KEY" ] && echo si || echo NO)"
      echo "cartella:    $(cat "$STATE/workdir" 2>/dev/null || echo NO)"
      echo "profilo:     $(cat "$STATE/profilo" 2>/dev/null || echo 'non definito')" ;;
    profilo)
      case "${1:-}" in base|intermedio|esperto) echo "$1" > "$STATE/profilo"; echo "profilo: $1";;
        *) die "profilo: base | intermedio | esperto";; esac ;;
    *) die "setup: import | keygen | workdir | status | profilo" ;;
  esac
}

cmd_write() {
  local env="${1:-}" sub="${2:-}"; check_env "$env"; shift 2 || true
  mkdir -p "$CHG"
  case "$sub" in
    preview)
      local sql="${1:-}" motivo="" out id count
      [ -n "$sql" ] || die "manca la query"
      [ "${2:-}" = "--motivo" ] && motivo="${3:-}"
      id="$(printf '%s' "$sql" | tr -s ' \t\n\r' ' ' | sha)"
      if [ "$env" = prod ] && [ ! -f "$CHG/$id.stage.ok" ]; then
        die "modifica $id mai applicata su stage: prima stage, poi produzione"
      fi
      out="$(remote "$env" preview "\"sql\":$(json_str "$sql")")" || exit 3
      count="$(printf '%s\n' "$out" | grep '^count=' | cut -d= -f2)"
      printf '%s' "$sql" > "$CHG/$id.sql"
      [ -n "$motivo" ] && printf '%s' "$motivo" > "$CHG/$id.motivo"
      echo "$count $(now)" > "$CHG/$id.$env.preview"
      echo "change_id=$id"
      echo "$out"
      if [ "$env" = prod ]; then
        local sc; sc="$(cut -d' ' -f1 "$CHG/$id.stage.ok")"
        echo "righe su stage: $sc | righe su prod: $count"
        [ "$sc" = "$count" ] || echo "ATTENZIONE: il numero di righe è diverso da stage. Spiegare al merchant prima di procedere."
        local t; t="$(od -An -tx1 -N6 /dev/urandom | tr -d ' \n')"
        echo "$t $(( $(now) + TOKEN_TTL ))" > "$CHG/$id.prod.token"
        echo "token=$t   (da usare SOLO dopo l'ok esplicito del merchant, scade tra 30 minuti)"
      fi ;;
    apply)
      local id="${1:-}" token="" pv count ts out aff rb w body esito
      [ -f "$CHG/$id.sql" ] || die "change_id sconosciuto: $id (fai prima 'ma write $env preview')"
      [ "${2:-}" = "--token" ] && token="${3:-}"
      pv="$CHG/$id.$env.preview"
      [ -f "$pv" ] || die "manca l'anteprima su $env per $id"
      count="$(cut -d' ' -f1 "$pv")"; ts="$(cut -d' ' -f2 "$pv")"
      [ $(( $(now) - ts )) -le $PREVIEW_TTL ] || die "anteprima scaduta: rifai 'ma write $env preview'"
      if [ "$env" = prod ]; then
        [ -f "$CHG/$id.stage.ok" ] || die "modifica non applicata su stage"
        [ -f "$CHG/$id.prod.token" ] || die "token assente: rifai l'anteprima su prod"
        local t exp; t="$(cut -d' ' -f1 "$CHG/$id.prod.token")"; exp="$(cut -d' ' -f2 "$CHG/$id.prod.token")"
        [ -n "$token" ] && [ "$token" = "$t" ] || die "token mancante o errato: serve l'ok del merchant e il token dell'anteprima prod"
        [ "$(now)" -le "$exp" ] || { rm -f "$CHG/$id.prod.token"; die "token scaduto: rifai l'anteprima su prod"; }
        rm -f "$CHG/$id.prod.token" # monouso
      fi
      w="$(workdir)"
      body="- Motivo: $(cat "$CHG/$id.motivo" 2>/dev/null || echo '-')
- SQL:
\`\`\`sql
$(cat "$CHG/$id.sql")
\`\`\`"
      if out="$(remote "$env" apply "\"sql\":$(json_str "$(cat "$CHG/$id.sql")"),\"expected\":${count:--1}" 2>&1)"; then
        aff="$(printf '%s\n' "$out" | grep '^affected=' | cut -d= -f2)"
        rb="$w/rollback/$id-$env-$(date +%Y%m%d-%H%M%S).sql"
        printf '%s\n' "$out" | sed '1,/^---ROLLBACK---$/d' > "$rb"
        echo "$aff $(now)" > "$CHG/$id.$env.ok"
        rm -f "$pv"
        log_entry "$env" "modifica DB" "$id" "$body
- Righe modificate: $aff
- Ripristino: rollback/$(basename "$rb")
- Esito: OK" >/dev/null
        echo "OK: $aff righe modificate su $env"
        echo "ripristino salvato: $rb"
        [ "$env" = stage ] && echo "prossimo passo: far verificare il merchant su stage, poi 'ma write prod preview' con la STESSA query"
      else
        log_entry "$env" "modifica DB" "$id" "$body
- Esito: FALLITA — $out" >/dev/null
        echo "$out" >&2; exit 3
      fi ;;
    *) die "write: preview | apply" ;;
  esac
}

cmd_restore() {
  local env="${1:-}" f="${2:-}" out; check_env "$env"
  [ -f "$f" ] || die "file di ripristino non trovato: $f"
  out="$(remote "$env" restore "\"sql\":$(json_str "$(cat "$f")")" 2>&1)" || { echo "$out" >&2; exit 3; }
  log_entry "$env" "ripristino" "" "- File: $f
- Esito: $out" >/dev/null
  echo "$out"
}

cmd_export() {
  local env="${1:-}" sql="${2:-}" nome="${3:-export}" w f; check_env "$env"
  w="$(workdir)"; f="$w/export/$nome-$(date +%Y%m%d-%H%M).csv"
  remote "$env" export "\"sql\":$(json_str "$sql")" > "$f" || { rm -f "$f"; exit 3; }
  log_entry "$env" "export" "" "- File: export/$(basename "$f")
- Righe: $(( $(wc -l < "$f") - 1 ))
- SQL: \`$(printf '%s' "$sql" | tr '\n' ' ')\`" >/dev/null
  echo "export salvato: $f"
}

main() {
  local c="${1:-help}"; shift || true
  case "$c" in
    setup) cmd_setup "$@" ;;
    check) check_env "${1:-}"; remote "$1" check ;;
    schema) check_env "${1:-}"; remote "$1" schema "${2:+\"table\":$(json_str "$2")}" ;;
    query) check_env "${1:-}"; remote "$1" query "\"sql\":$(json_str "${2:-}"),\"limit\":${4:-200}" ;;
    export) cmd_export "$@" ;;
    write) cmd_write "$@" ;;
    restore) cmd_restore "$@" ;;
    cache) check_env "${1:-}"; out="$(remote "$1" cache)" || exit 3; echo "$out"; log_entry "$1" "cache svuotata" "" "- $out" ;;
    modules) check_env "${1:-}"; remote "$1" modules ;;
    log) log_entry "-" "nota" "" "${1:-}" ;;
    *) cat <<'EOF'
ma setup import <file> | keygen | workdir <cartella> | status | profilo <livello>
ma check <stage|prod>
ma schema <env> [tabella]                 tabelle, o colonne di una tabella (usa PREFIX_)
ma query <env> "<SELECT>" [--limit N]     sola lettura, default 200 righe
ma export <env> "<SELECT>" <nome>         CSV nella cartella export/
ma write <env> preview "<SQL>" [--motivo "testo"]
ma write <env> apply <change_id> [--token T]   prod: serve token + stage già applicato
ma restore <env> <file-rollback>
ma cache <env> | ma modules <env> | ma log "<nota>"
EOF
    ;;
  esac
}
main "$@"
